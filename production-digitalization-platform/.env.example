# Copied to .env automatically by start.bat / start.sh. Every value has a sensible default.

# ---- Local AI model (Ollama). Remove "llm" to skip the ~3 GB download on slow/low-RAM machines;
# ---- the advisor then uses its rule-based fallback.
COMPOSE_PROFILES=llm
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b

# ---- Optional: use Claude instead of the local model (set LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Data
# metropt3  = real compressor data from UCI (downloaded once, ~208 MB)
# synthetic = generated offline data in the same format
DATASET=metropt3
# Part 1 (commissioning / training) = everything before this date
COMMISSIONING_END=2020-03-01

# ---- Live replay
# 60 = one hour of machine data per real minute. Use 300 for a fast demo.
REPLAY_SPEED=60
# auto = start 12 h before the first known failure so you see an alarm within minutes
LIVE_START=auto

# ---- Production line simulator: 1 = real time, 5 = five times faster
LINE_TIME_SCALE=1

# ---- KPIs
KPI_BUCKET_MINUTES=15
SUMMARY_INTERVAL_MIN=15

# ---- Passwords (local demo defaults)
DB_PASSWORD=factory
GRAFANA_ADMIN_PASSWORD=admin
