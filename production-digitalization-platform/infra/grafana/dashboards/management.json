  "panels": [
    {
      "id": 13,
      "type": "stat",
      "title": "Line OEE (period)",
      "description": "OEE of the bottleneck station ST30 over the selected period",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT (sum(k.run_s) / nullif(sum(k.planned_s), 0))\n       * least(1, sum(k.total_count * s.ideal_cycle_s) / nullif(sum(k.run_s), 0))\n       * (sum(k.good_count)::float / nullif(sum(k.total_count), 0))\nFROM kpi.station_kpis k JOIN master.stations s USING (station_id)\nWHERE $__timeFilter(k.bucket) AND k.station_id = 'ST30'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.75
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
