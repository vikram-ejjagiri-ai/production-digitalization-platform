    {
      "id": 22,
      "type": "barchart",
      "title": "Downtime by station and reason (minutes)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT station_id AS \"Station\",\n       sum(downtime_s) FILTER (WHERE reason = 'material_missing') / 60 AS \"material missing\",\n       sum(downtime_s) FILTER (WHERE reason = 'machine_fault') / 60 AS \"machine fault\",\n       sum(downtime_s) FILTER (WHERE reason = 'tool_change') / 60 AS \"tool change\",\n       sum(downtime_s) FILTER (WHERE reason = 'quality_check') / 60 AS \"quality check\",\n       sum(downtime_s) FILTER (WHERE reason = 'operator_absent') / 60 AS \"operator absent\",\n       sum(downtime_s) FILTER (WHERE reason = 'low_air_pressure') / 60 AS \"low air pressure\"\nFROM kpi.downtime_reasons WHERE $__timeFilter(bucket) GROUP BY station_id ORDER BY station_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "normal",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
