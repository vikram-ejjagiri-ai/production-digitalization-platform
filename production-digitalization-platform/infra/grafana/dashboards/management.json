    {
      "id": 20,
      "type": "barchart",
      "title": "OEE breakdown by station (A x P x Q)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT k.station_id AS \"Station\",\n       sum(k.run_s) / nullif(sum(k.planned_s), 0) AS \"Availability\",\n       least(1, sum(k.total_count * s.ideal_cycle_s) / nullif(sum(k.run_s), 0)) AS \"Performance\",\n       sum(k.good_count)::float / nullif(sum(k.total_count), 0) AS \"Quality\"\nFROM kpi.station_kpis k JOIN master.stations s USING (station_id)\nWHERE $__timeFilter(k.bucket) GROUP BY k.station_id, s.sequence ORDER BY s.sequence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          },
          "max": 1,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 21,
      "type": "barchart",
      "title": "Downtime Pareto (minutes)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
