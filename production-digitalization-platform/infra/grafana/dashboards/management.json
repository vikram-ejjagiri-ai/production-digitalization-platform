            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT reason AS \"Reason\", sum(downtime_s) / 60 AS \"Downtime\"\nFROM kpi.downtime_reasons WHERE $__timeFilter(bucket) GROUP BY reason ORDER BY 2 DESC"
        }
