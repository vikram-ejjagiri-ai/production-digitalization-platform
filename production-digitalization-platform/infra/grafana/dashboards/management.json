    {
      "id": 24,
      "type": "table",
      "title": "Material flow by station (RFID)",
      "description": "Long waits in front of a station point to the bottleneck",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT f.station_id AS \"Station\", s.name AS \"Name\", sum(f.parts) AS \"Parts\",\n       round((sum(f.avg_dwell_s * f.parts) / nullif(sum(f.parts), 0))::numeric, 1) AS \"Avg time in station [s]\",\n       round((sum(f.avg_wait_before_s * f.parts) / nullif(sum(f.parts) FILTER (WHERE f.avg_wait_before_s IS NOT NULL), 0))::numeric, 1)\n         AS \"Avg wait before station [s]\",\n       s.ideal_cycle_s AS \"Ideal cycle [s]\"\nFROM kpi.station_flow f JOIN master.stations s USING (station_id)\nWHERE $__timeFilter(f.bucket) GROUP BY f.station_id, s.name, s.sequence, s.ideal_cycle_s ORDER BY s.sequence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Avg wait before station [s]"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 180
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 25,
      "type": "table",
      "title": "Reliability by station",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT station_id AS \"Station\", sum(failures) AS \"Stops\",\n       round((sum(downtime_s) / 60)::numeric, 1) AS \"Downtime [min]\",\n       round((sum(run_s) / nullif(sum(failures), 0) / 60)::numeric, 1) AS \"MTBF [min]\",\n       round((sum(downtime_s) / nullif(sum(failures), 0) / 60)::numeric, 1) AS \"MTTR [min]\",\n       sum(scrap_count) AS \"Scrap\"\nFROM kpi.station_kpis WHERE $__timeFilter(bucket) GROUP BY station_id ORDER BY station_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
