    {
      "id": 37,
      "type": "table",
      "title": "Why? Top deviations in the latest window",
      "description": "Window features furthest from the healthy baseline learned in Part 1",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT c->>'feature' AS \"Feature\", c->>'sensor' AS \"Sensor\", (c->>'z')::float AS \"z-score\",\n       c->>'direction' AS \"Direction\", (c->>'value')::float AS \"Now\", (c->>'baseline')::float AS \"Commissioning baseline\"\nFROM (SELECT contributors FROM clean.machine_health ORDER BY ts DESC LIMIT 1) h,\n     jsonb_array_elements(h.contributors) c"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "z-score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 3
                    },
                    {
                      "color": "red",
                      "value": 6
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
