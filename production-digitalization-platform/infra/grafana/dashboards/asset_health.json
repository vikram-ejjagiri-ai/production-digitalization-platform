{
  "uid": "asset-health",
  "title": "Compressor - Asset health (predictive maintenance)",
  "description": "Live machine health against the commissioning baseline",
  "tags": [
    "maintenance",
    "compressor"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Compressor alarms",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tsdb"
        },
        "target": {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT opened_at AS time, coalesce(closed_at, now()) AS timeend, 'Compressor alarm #' || alarm_id AS text FROM clean.alarms WHERE opened_at < $__timeTo() AND coalesce(closed_at, now()) > $__timeFrom()"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Shopfloor",
      "type": "link",
      "url": "/d/shopfloor",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
