          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT opened_at AS time, coalesce(closed_at, now()) AS timeend, 'Compressor alarm #' || alarm_id AS text FROM clean.alarms WHERE opened_at < $__timeTo() AND coalesce(closed_at, now()) > $__timeFrom()"
