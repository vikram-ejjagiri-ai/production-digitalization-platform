    {
      "id": 11,
      "type": "bargauge",
      "title": "Station OEE (last 15 min)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT k.station_id AS \"Station\",\n       (sum(k.run_s) / nullif(sum(k.planned_s), 0))\n       * least(1, sum(k.total_count * s.ideal_cycle_s) / nullif(sum(k.run_s), 0))\n       * (sum(k.good_count)::float / nullif(sum(k.total_count), 0)) AS \"OEE\"\nFROM kpi.station_kpis k JOIN master.stations s USING (station_id)\nWHERE k.bucket > now() - interval '15 minutes'\nGROUP BY k.station_id, s.sequence ORDER BY s.sequence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.6
              },
              {
                "color": "green",
                "value": 0.75
              }
            ]
          },
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "sizing": "auto"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Active / recent compressor alarms with AI recommendation",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT alarm_id AS \"Alarm\", opened_at AS \"Opened\", status AS \"Status\", dataset_time AS \"Dataset time\",\n       round(min_health::numeric, 0) AS \"Min health\", urgency AS \"Urgency\", likely_cause AS \"Likely cause\",\n       (SELECT string_agg(value, '  |  ') FROM jsonb_array_elements_text(recommended_actions)) AS \"Recommended actions\",\n       provider AS \"Advisor\"\nFROM kpi.v_alarm_log WHERE status = 'open' OR closed_at > now() - interval '30 minutes' ORDER BY opened_at DESC LIMIT 5"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "open": {
                        "color": "red",
                        "index": 0
                      },
                      "closed": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
