    {
      "id": 8,
      "type": "table",
      "title": "Station status",
      "description": "WAITING = starved (no part) or blocked (next buffer full)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tsdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH last AS (\n  SELECT DISTINCT ON (station_id) station_id, event_type, reason, ts\n  FROM clean.line_events WHERE event_type IN ('downtime_start','downtime_end','cycle_start','cycle_end')\n  ORDER BY station_id, ts DESC)\nSELECT s.station_id AS \"Station\", s.name AS \"Name\",\n       CASE WHEN l.event_type = 'downtime_start' THEN 'DOWN'\n            WHEN l.event_type = 'cycle_start' THEN 'RUNNING'\n            WHEN l.event_type IS NULL THEN 'NO DATA' ELSE 'WAITING' END AS \"State\",\n       CASE WHEN l.event_type = 'downtime_start' THEN l.reason END AS \"Stop reason\",\n       round(extract(epoch FROM now() - l.ts)) AS \"In state [s]\",\n       k.oee AS \"OEE (bucket)\", k.good_count AS \"Good (bucket)\"\nFROM master.stations s\nLEFT JOIN last l USING (station_id)\nLEFT JOIN LATERAL (SELECT oee, good_count FROM kpi.station_kpis k WHERE k.station_id = s.station_id\n                   ORDER BY bucket DESC LIMIT 1) k ON TRUE\nORDER BY s.sequence"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "DOWN": {
                        "color": "red",
                        "index": 0
                      },
                      "RUNNING": {
                        "color": "green",
                        "index": 1
                      },
                      "WAITING": {
                        "color": "#EAB839",
                        "index": 2
                      },
                      "NO DATA": {
                        "color": "gray",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OEE (bucket)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "#EAB839",
                      "value": 0.6
                    },
                    {
                      "color": "green",
                      "value": 0.75
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
